set title "AP\\@all por consulta, stopwords+stemming (BM25 k1=1.2, b=0.75)"
set size square
set xrange [-0.02:1.02]
set yrange [-0.02:1.02]
set xlabel "AP\\@all vetorial"
set ylabel "AP\\@all BM25"
set key bottom right
plot x with lines dt 2 lc rgb "#888888" notitle, \
     $all using 1:2 with points pt 7 ps 0.8 lc rgb "#66888888" title "consultas", \
     $b using 1:2 with points pt 7 ps 1.6 lc rgb "#2a9d8f" title "BM25 muito melhor", \
     '' using 1:2:3 with labels offset 1.4,0.6 font ",10" notitle, \
     $v using 1:2 with points pt 7 ps 1.6 lc rgb "#c44e52" title "vetorial muito melhor", \
     '' using 1:2:3 with labels offset 1.4,0.6 font ",10" notitle
